            }
          }
        },
        {
          "name": "Create published event",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var d = new Date(Date.now() + 1000 * 60 * 60 * 24 * 3);",
                  "function pad(n) { return n < 10 ? '0' + n : '' + n; }",
                  "var s = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());",
                  "pm.collectionVariables.set(\"eventDate\", s);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set(\"eventId\", json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"annotation\": \"Annotation for a great event with comments\",\n  \"category\": {{catId}},\n  \"description\": \"Full description of a great event with comments feature\",\n  \"eventDate\": \"{{eventDate}}\",\n  \"location\": { \"lat\": 55.754167, \"lon\": 37.62 },\n  \"paid\": false,\n  \"participantLimit\": 0,\n  \"requestModeration\": false,\n  \"title\": \"Great Event\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{authorId}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{authorId}}",
                "events"
              ]
            }
          }
        },
        {
          "name": "Publish event (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Event is PUBLISHED\", function () { pm.expect(pm.response.json().state).to.eql(\"PUBLISHED\"); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stateAction\": \"PUBLISH_EVENT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "events",
                "{{eventId}}"
              ]
            }
          }
        },
        {
          "name": "Create second (unpublished) event",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var d = new Date(Date.now() + 1000 * 60 * 60 * 24 * 5);",
                  "function pad(n) { return n < 10 ? '0' + n : '' + n; }",
                  "var s = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());",
                  "pm.collectionVariables.set(\"eventDate2\", s);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"unpublishedEventId\", pm.response.json().id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"annotation\": \"Annotation for an unpublished pending event\",\n  \"category\": {{catId}},\n  \"description\": \"Full description of an unpublished pending event item\",\n  \"eventDate\": \"{{eventDate2}}\",\n  \"location\": { \"lat\": 55.754167, \"lon\": 37.62 },\n  \"paid\": false,\n  \"participantLimit\": 0,\n  \"requestModeration\": false,\n  \"title\": \"Pending Event\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{authorId}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{authorId}}",
                "events"
              ]
            }
          }
        }
      ]
